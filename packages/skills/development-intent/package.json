{
  "name": "@diego/development-intent",
  "version": "0.0.1",
  "description": "An OakShelf skill that converts a raw task request into a stable, structured PR intent.",
  "license": "MIT",
  "author": "Diego Landa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegolanda/ai-flows.git",
    "directory": "packages/skills/development-intent"
  },
  "homepage": "https://github.com/diegolanda/ai-flows/tree/main/packages/skills/development-intent#readme",
  "bugs": {
    "url": "https://github.com/diegolanda/ai-flows/issues"
  },
  "keywords": [
    "oakshelf",
    "skill",
    "intent",
    "pull-request",
    "ai"
  ],
  "files": [
    "oakshelf.json",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "evals"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@diego/simple-technical-writing": "workspace:^"
  },
  "oakshelf": {
    "kind": "skill",
    "manifest": "./oakshelf.json"
  },
  "scripts": {
    "check": "node ../../../scripts/check-package.mjs . skill",
    "pack:dry": "npm pack --dry-run"
  }
}
